# ===========================================================================
# dagger-kubernetes Supervisor — full configuration reference.
# Copy this file to config.app.yaml and edit the values you need; any key
# omitted here falls back to the compiled-in defaults in
# config/loader.go.
#
# Every value can also be set via an environment variable using the
# DAGGER_KUBERNETES_ prefix (dots -> underscores, uppercase). Examples:
#   server.public_url        -> DAGGER_KUBERNETES_SERVER_PUBLIC_URL
#   cache.s3.endpoint        -> DAGGER_KUBERNETES_CACHE_S3_ENDPOINT
#   fleet.max_replicas_per_version -> DAGGER_KUBERNETES_FLEET_MAX_REPLICAS_PER_VERSION
# Environment variables take precedence over this file.
#
# Duration values accept Go time.ParseDuration syntax (ns, us, µs, ms, s, m, h)
# plus the extensions "d" (day) and "w" (week), e.g. "7d", "1w", "1.5d12h",
# "2d3h". Map keys may contain dots — e.g. fleet.engine_registry_mirrors
# ("docker.io", "ghcr.io") and fleet.engine_pvc_labels
# ("recurring-job-group.longhorn.io/nobackup") — and are preserved verbatim.
#
# When deploying with the Helm chart (recommended for production), the
# config file is rendered from deploy/helm/dagger-kubernetes/values.yaml and
# auto-wires telemetry/cache URLs to the in-cluster dependency Services.
# The Helm chart also manages the telemetry stack (OTel Collector, Tempo,
# Loki, VictoriaMetrics, Grafana) and the MinIO S3 store as subchart
# dependencies, each toggleable independently. See deploy/helm/dagger-kubernetes/README.md.
# ===========================================================================

# --- Endpoints & public URLs ------------------------------------------------
server:
  control_addr: ":8080"        # Address the Hertz control API listens on (TLS enabled when cert/key configured).
  data_addr: ":8443"           # Address the mTLS L4 data-plane proxy listens on.
  data_hostname: "data.supv.example.com"  # Public hostname clients dial for the data plane.
  public_url: "https://supv.example.com"  # Public base URL of the control plane (also serves the UI and is the base for pipeline-view links: /pipelines/<traceID>).

# --- Authentication ----------------------------------------------------------
auth:
  # Static bearer-token auth. Tokens live one per line in tokens_file.
  # DEPRECATED: legacy fallback only. Migrate with `supervisor migrate-tokens`
  # then remove this key. See ADR-010.
  internal:
    enabled: true                                   # false = disable username/password + legacy-token auth; ONLY allowed when auth.oauth.enabled: true with a fully configured provider. Auth is always enforced (no fully-disabled mode).
    tokens_file: "/etc/dagger-kubernetes/tokens"         # legacy fallback + migration source only.
    # When auth.internal.enabled: false, OAuth must be fully configured for the chosen provider or config load fails.

  # Bootstrap admin: created on first boot when the users table is empty.
  bootstrap_admin:
    username: "admin"                               # created on first boot when no users exist.
    password: ""                                    # empty = random password logged once at first boot.

  # JWT (HS256) issuance for username/password and OAuth login.
  jwt:
    secret: ""                                      # HS256 signing key (>= 32 bytes, enforced); empty = auto-generated and persisted in the DB.
                                                    # In production set via env (DAGGER_KUBERNETES_AUTH_JWT_SECRET) or the Helm <release>-jwt Secret — never this file.
    access_ttl: "15m"
    refresh_ttl: "7d"                               # 168h; refresh rotated on use. "d"/"w" units accepted.

  # API-token plaintext recovery (Connect-env UI). AES-256-GCM key (>= 32 bytes).
  # Empty = auto-generated and persisted in the DB meta table (dev mode).
  # Configure via env (DAGGER_KUBERNETES_AUTH_TOKEN_ENCRYPTION_KEY) in production
  # so DB compromise alone does not yield token plaintexts.
  token:
    encryption_key: ""

  # Optional OAuth for human/UI login. Single active provider per deployment
  # (selected by `provider`); simultaneous multi-provider is not supported.
  oauth:
    enabled: false
    provider: "github"                 # "github" | "oidc" (generic OIDC: Dex, Keycloak, Google, Auth0, ...).
    client_id: "${OAUTH_CLIENT_ID}"    # set via env, do not commit secrets.
    client_secret: ""                   # set via env (DAGGER_KUBERNETES_AUTH_OAUTH_CLIENT_SECRET) or the Helm <release>-oauth Secret — never this file.
    redirect_url: "https://supv.example.com/api/v1/auth/oauth/github/callback"  # backend endpoint (302s to SPA with session cookies). Use /oidc/callback for provider: oidc.
    allowed_orgs: []                   # github: org membership allowlist; oidc: deprecated alias for allowed_groups; empty = allow all.
    allowed_teams: []                  # github only: "org/team" slug allowlist; empty = allow all. AND-ed with allowed_orgs when both set.
    allowed_groups: []                 # oidc only: groups-claim allowlist (canonical); union with allowed_orgs; empty = allow all.
    group_mappings: []                 # regex provider-group -> supervisor-group mapping (first-match-wins; no match drops; empty = no mapping).
      # - pattern: '^github\.com/acme-(.*)$'   # Go regexp vs incoming provider group name (case-sensitive; (?i) for insensitive).
      #   replacement: 'acme-$1'               # target supervisor group name; $1/${name} capture substitution, $$ = literal $.
    # NOTE: group_mappings assigns GROUP MEMBERSHIP only, never the admin ROLE.
    # Mapped target groups are AUTO-CREATED when missing, with
    # mapped_group_max_runner_sessions and agent_available=true; a group that
    # already exists is left unchanged. allowed_groups / allowed_orgs are checked
    # against the RAW upstream groups BEFORE mapping. Use admin_groups to grant
    # the admin role.
    mapped_group_max_runner_sessions: 0   # default max_runner_sessions (concurrent engine sessions) for groups AUTO-CREATED by group_mappings; 0 = unlimited. Applied only at creation time; never overwrites an existing group's quota.
    default_group: ""                  # new OAuth users auto-join this group (must exist); empty = none.
    admin_groups: []                   # upstream IdP group names granting the admin role on login/revalidation (exact, case-sensitive, pre-mapping); empty = disabled.
      # - 'HM_ADM_ETL_Outils'           # a Dex/OIDC groups-claim value; GitHub: an org login or "org/team" slug.
    cookie_secure: false               # force the Secure flag on the oauth_state cookie; set true when TLS terminates at an ingress/proxy in front of the supervisor.
    # OIDC-only fields (provider: oidc). Ignored when provider: github.
    issuer_url: ""                     # e.g. "https://dex.example.com" or "http://localhost:5556" (loopback http allowed for dev).
    scopes: ["openid", "profile", "email"]  # "openid" is always included.
    username_claim: "preferred_username"   # fallback: "email"; error if both absent.
    groups_claim: "groups"              # claim holding group names; array or single string; absent = no groups.
    # --- IdP group-membership revalidation (ADR-027) -----------------------
    # Detects when a user is removed from the allowed OAuth group (or deleted
    # from the IdP) while already holding tokens, and revokes their access.
    # Outcomes (behaviour matrix, issue #30):
    #   - userinfo OK                          -> membership reconciled.
    #   - userinfo OK but groups fail allowed_groups/admin_groups
    #                                            -> deactivation + dct_ API-token revoke.
    #   - OIDC refresh invalid_grant/invalid_token/401 (refresh token expired,
    #     rotated, stateless Dex restart, or genuinely revoked — RFC 6749 §5.2
    #     does not let the supervisor distinguish these)
    #                                            -> "cannot verify", NEVER treated
    #     as revocation: cached groups keep being served within revalidate_grace,
    #     then revalidate_fail_open/fail-closed applies; the user is never
    #     deactivated and the API token is never deleted. Re-auth on the UI
    #     stores a fresh credential and recovers on the very next check.
    #   - IdP unreachable (transport)          -> same grace/fail policy as above.
    # Dex recipe for "never force re-auth while keeping revocation polling":
    #   - persistent storage (kubernetes/sqlite3/postgres) so refresh tokens
    #     survive Dex restarts,
    #   - oauth2.refreshTokens: unset/large absoluteLifetime, generous
    #     validIfNotUsedFor,
    #   - reuseInterval > revalidate_interval (the supervisor polls per user;
    #     also avoids multi-pod refresh races),
    #   - session_max_age below as the hard backstop forcing periodic re-login.
    revalidate_interval: "5m"   # per-user cache TTL for successful IdP re-checks; bounds the detection delay.
    revalidate_grace: "1h"      # serve last-known-good membership for this long when the IdP is unreachable or the OIDC credential is unusable.
    revalidate_fail_open: false # after grace, false = deny (fail-closed), true = allow (fail-open).
                                #   WARNING: fail_open: true COMBINED with session_max_age: "0" (disabled) trusts the
                                #   last-known-good groups INDEFINITELY while the credential stays unusable: fail-open
                                #   only serves cached groups, and session_max_age: "0" removes the re-login bound that
                                #   would force a fresh allowlist evaluation. Prefer fail-closed (default), or pair
                                #   fail-open with a finite session_max_age (availability-over-security tradeoff).
    session_max_age: "0"        # optional hard bound on an OAuth session (refresh-token age); 0 = disabled.
                                #   Set e.g. "24h" during rollout to bound sessions issued before this change.

  # Session cookies (SPA auth). Access/refresh JWTs are delivered in httpOnly
  # cookies instead of localStorage (CWE-922). Bearer auth for CI is unaffected
  # (additive). SameSite=Lax, Path=/ are always set.
  cookie:
    access_name: "dagger_kubernetes_access"   # httpOnly access-JWT cookie name.
    refresh_name: "dagger_kubernetes_refresh" # httpOnly refresh-JWT cookie name.
    secure: false                             # force the Secure flag; set true when TLS terminates at an ingress/proxy in front of the supervisor.

  # Cross-origin access for split-UI deployments (same-origin needs no config).
  cors:
    allowed_origins: []                       # exact-match Origin allowlist; empty = same-origin only (no Access-Control-Allow-Origin header).

# --- Database ----------------------------------------------------------------
# Raft data directory: holds raft.db (boltdb log+stable), snapshots/, node-id.
# Persist on a volume (PVC / bind-mount) in production.
# NOTE: this is a fresh-start store. There is NO migration from legacy SQLite
# data; existing SQLite data is intentionally not carried over.
database:
  dir: "/var/lib/dagger-kubernetes"

# --- Raft (distributed store) ------------------------------------------------
# Raft ALWAYS runs, even for a single-node deployment. For single-node, leave
# peers empty (the node bootstraps with itself as the only voter). For a
# multi-node cluster, either:
#   - set raft.peers to the full voter list (including self), OR
#   - set raft.replicas + raft.statefulset_name + raft.headless_service so the
#     supervisor derives the peer list from the StatefulSet's stable pod DNS
#     names (<sts>-<i>.<headless>.<ns>.svc.<cluster-domain>) — no K8s API calls.
#     (In the Helm chart raft.replicas is NOT asked: it derives from
#     supervisor.replicaCount, one pod = one voter. This key is for non-Helm
#     deployments.)
#
# SECURITY: enable raft.tls.enabled (mTLS) before running multi-node. The Helm
# chart enables it by default and shares the internal raft CA via a K8s Secret.
# With TLS disabled the Raft transport is plaintext TCP; single-node is
# unaffected (no inter-node traffic).
raft:
  node_id: ""              # "" = load/generate a stable UUID at <dir>/node-id.
  bind_addr: ":8081"       # dedicated Raft transport port (not control/data).
  advertise_addr: ""       # "" = derive from <hostname>.<headless_service>.<namespace>.svc.<cluster_domain>.
  peers: []                # explicit full voter list (non-K8s/testing). Empty = DNS discovery.
    # - id: "node-1"
    #   address: "supervisor-0.supervisor-headless:8081"
    # - id: "node-2"
    #   address: "supervisor-1.supervisor-headless:8081"
  replicas: 1              # StatefulSet replica count for DNS peer discovery.
  statefulset_name: ""     # e.g. "dagger-kubernetes-supervisor" (DNS discovery).
  headless_service: ""     # e.g. "dagger-kubernetes-headless" (DNS discovery).
  namespace: ""            # K8s namespace for pod DNS (default = release ns).
  # Peer discovery and the advertise address are DNS-FQDN only: stable pod DNS
  # names, never pod IPs (pod IPs change on every pod recreation).
  cluster_domain: "cluster.local"   # K8s cluster DNS suffix appended to peer addresses. FQDN avoids CoreDNS negative-cache poisoning (short .svc names route through the cache plugin, which can serve stale NXDOMAIN for up to 30 s during bootstrap). Set to "" only when your cluster DNS does not serve the cluster.local suffix.
  apply_timeout: "5s"
  leader_wait_timeout: "120s"
  snapshot_threshold: 1000
  snapshot_interval: "10m"
  trailing_logs: 256
  transport_max_pool: 1   # Raft transport connection pool per peer. Smaller = fresher DNS, important when pod IPs change across restarts (StatefulSet rolling update, Cilium eBPF DNS cache).
  tls:
    enabled: false         # binary default (plaintext single-node dev/test). Helm chart sets true.
    dir: ""                # "" = <database.dir>/tls
    validity: "8760h"      # leaf cert TTL (1y).
    organization: "dagger-kubernetes-raft"
    ca_cert: ""            # manual mode: path to CA cert PEM.
    cert: ""               # manual mode: path to leaf cert PEM.
    key: ""                # manual mode: path to leaf key PEM.
    ca_secret: ""          # auto/K8s mode: Secret name for CA sharing.
    ca_bootstrap: false    # auto/K8s mode: true = this node generates the CA (auto-detects ordinal 0).
    client_auth: true      # mTLS (RequireAndVerifyClientCert).

# --- Telemetry backend endpoints --------------------------------------------
# Used by the Supervisor to query traces/logs/metrics for the UI and to
# forward Dagger CLI OTLP when DAGGER_KUBERNETES_OTEL_OTLP_ENDPOINT is empty.
#
# On Kubernetes, in-cluster endpoints MUST use the <service>.<namespace>.svc
# form (e.g. http://loki.dagger-kubernetes.svc:3100) — never a bare service
# name (http://loki:3100) or a .svc.<cluster-domain> FQDN. That way a single
# `.svc` entry in NO_PROXY covers every in-cluster component when HTTP_PROXY
# is set on the supervisor (e.g. to download the Dagger CLI). See
# CONTRIBUTING.md. The bare-name values below are only the non-K8s (dev /
# docker-compose) fallbacks; the Helm chart auto-wires the .svc form.
telemetry:
  collector_url: "http://otel-collector:4318"   # OTLP/HTTP collector.
  tempo_url: "http://tempo:3200"                # Tempo traces API.
  loki_url: "http://loki:3100"                  # Loki logs API.
  victoria_url: "http://victoria:8428"           # VictoriaMetrics API (PromQL-compatible).

# --- Cache store & CLI cache --------------------------------------------------
# The only cache backend is S3: it backs the on-the-fly CLI tarball cache
# (cli.enabled). Engines keep their BuildKit local cache on their per-pod PVC;
# the worker-cache sync and the remote-cache registry proxy were removed.
cache:
  s3:                                # shared S3 client for the CLI cache (cli.s3_bucket).
    bucket: ""                       # default CLI-cache bucket. Empty + cli.enabled = config load error.
    region: "us-east-1"              # S3 region (required by AWS S3; ignored by MinIO).
    endpoint: ""                     # S3-compatible endpoint, e.g. "minio.example.com:9000". Empty = the supervisor logs a WARN and disables the S3-backed CLI cache (non-S3 dev setups).
    use_ssl: true                    # use HTTPS for the S3 endpoint.
    access_key: ""                   # set via env/Secret in production (DAGGER_KUBERNETES_CACHE_S3_ACCESS_KEY); empty = AWS env credential chain. Never put credentials in a committed file.
    secret_key: ""                   # set via env/Secret in production (DAGGER_KUBERNETES_CACHE_S3_SECRET_KEY); never logged.

# --- Local image cache (Zot mirrors) -----------------------------------------
# Admin-visible/read-only list of the local Zot image mirrors the supervisor
# lists and prunes over their OCI Distribution v2 API (GET /api/v1/image-cache,
# POST /api/v1/image-cache/prune, POST /api/v1/image-cache/prune-all). The Helm
# chart renders this block from what it deploys; it is not normally set by hand.
# Prune unlinks a manifest immediately; Zot's online GC reclaims the
# unreferenced blob bytes after gcDelay on the next gcInterval cycle.
image_cache:
  mirrors: []                        # each: {id, host, upstream, internal_addr, backend}
    # - id: "docker-io"              # mirror lookup key (chart slug of host).
    #   host: "docker.io"           # upstream host.
    #   upstream: "https://registry-1.docker.io"  # upstream base URL (informational).
    #   internal_addr: "release-docker-io-mirror.dagger.svc:5000"  # in-cluster Zot Service address.
    #   backend: "s3"               # "s3" | "pvc" (informational; prune is identical).

# --- Pipeline history retention ------------------------------------------------
# Pipeline history = trace metadata (Raft FSM) + Loki logs + VictoriaMetrics
# metrics. Auto-purge removes all three for traces whose last update
# (COALESCE(started_at, updated_at)) is older than max_age. Tempo spans are NOT
# deleted here — set tempo.retention to a matching (or longer) value so spans
# age out alongside the supervisor-side purge. Running traces are protected.
# See ADR-018.
history:
  gc:                                # auto-purge sweeper for pipeline history.
    enabled: false                   # master switch; disabled by default.
    max_age: "720h"                  # purge traces whose last update is older than this (30d).
    schedule: "1h"                   # background sweeper ticker interval.

# --- Engine fleet (Kubernetes) ----------------------------------------------
fleet:
  namespace: "dagger-kubernetes"                # namespace engines run in.
  max_replicas_per_version: 3              # ceiling for the per-version autoscaler.
  max_sessions_per_replica: 8              # sessions pinned to one engine pod.
  replica_idle_ttl: "5m"                    # idle pod TTL before scale-down.
  version_retention: "24h"                   # idle version GC: delete a version's StatefulSet+Service after this long with zero replicas and no pinned sessions (<= 0 disables; positive values < 1m are rejected).

  # --- Engine pod template ---------------------------------------------------
  engine_image_registry: "registry.dagger.io/engine"  # base registry for engine images.
  engine_storage_class: ""                            # StorageClass for engine PVCs (default uses default).
  engine_storage_size: "50Gi"                         # local cache disk per engine pod.
  engine_pvc_labels: {}                               # extra labels added to engine PVCs (map; managed app/version labels take precedence).
  engine_cpu_request: "500m"                          # CPU request per engine pod.
  engine_cpu_limit: "2000m"                           # CPU limit per engine pod.
  engine_memory_request: "1Gi"                        # memory request per engine pod.
  engine_memory_limit: "8Gi"                          # memory limit per engine pod.
  engine_termination_grace_seconds: 120               # termination grace period for engine pods.
  engine_pull_policy: "IfNotPresent"                   # engine image pull policy.
  engine_privileged: false                        # run engine container as privileged (set to true only if a BuildKit feature requires it).
  engine_node_selector: {}                            # node selector for engine pods (map).
  engine_tolerations: []                              # tolerations in "key:value:effect" format.
  engine_extra_args: []                               # additional CLI args passed to dagger engine.
  engine_extra_env: {}                            # extra env vars for engine pods, e.g. proxy settings:
    # HTTP_PROXY: "http://proxy.corp.example:3128"
    # HTTPS_PROXY: "http://proxy.corp.example:3128"
    # NO_PROXY: "localhost,127.0.0.1,.svc,.cluster.local"
    # http_proxy: "http://proxy.corp.example:3128"
    # https_proxy: "http://proxy.corp.example:3128"
    # no_proxy: "localhost,127.0.0.1,.svc,.cluster.local"
  engine_extra_env_from: {}                       # env vars sourced from K8s Secret keys (map: env name -> {secretName, key}).
    # Use for credentials that must never appear in plaintext config, e.g. an authenticated proxy:
    # HTTP_PROXY:
    #   secretName: "proxy-credentials"
    #   key: "http_proxy"            # secret value: "http://user:pass@proxy.corp.example:3128"
    # HTTPS_PROXY:
    #   secretName: "proxy-credentials"
    #   key: "https_proxy"
  engine_ca_secret: ""                            # K8s Secret with a custom CA PEM bundle for engine pods; mounted at /usr/local/share/ca-certificates. Dagger auto-detects CAs from this directory on startup. Empty = disabled.
  engine_ca_secret_key: "ca.crt"                  # key inside engine_ca_secret holding the PEM bundle.
  engine_debug: false                             # engine.toml: debug = true (verbose engine logging).
  engine_log_format: "json"                       # engine.toml: [log] format; "" omits the section.
  engine_registry_mirrors: {}                     # engine.toml registry mirrors, e.g. {"docker.io": ["mirror.gcr.io"]}.
  engine_registry_mirrors_http: []                # mirror host[:port] values dialed over plaintext HTTP; engine.toml emits [registry."<mirror>"] + http = true per entry (the Helm chart fills it with the local image-cache mirrors).

# --- Certificate authority (client mTLS) -------------------------------------
ca:
  minting_ca_secret: "supervisor-minting-ca"  # K8s Secret holding the minting CA (AUTO-BOOTSTRAPPED on first boot; holds the CA private key).
  client_cert_ttl: "2h"                        # TTL of client certs minted at lease grant.

# --- Supervisor data plane (server TLS) --------------------------------------
# The minting CA (above) is AUTO-BOOTSTRAPPED for every provider and shared
# across pods via ca.minting_ca_secret (ordinal 0 generates it, others poll).
# `provider` only decides where the server certificate comes from:
supervisor:
  dataplane:
    tls:
      provider: "embedded"              # "embedded" (minting CA issues a self-signed server cert) | "cert-manager" | "external" (custom/operator keypair).
      ca_path: "/var/lib/dagger-kubernetes/ca"   # path to persist the embedded minting CA (Docker bind-mount or PVC); also a local cache of the shared Secret.
      cert_path: "/etc/dagger-kubernetes/tls/tls.crt"  # PEM cert path for the cert-manager/external providers (the Helm chart auto-wires cert-manager to /etc/dagger-kubernetes/data-tls/tls.crt).
      key_path: "/etc/dagger-kubernetes/tls/tls.key"   # PEM key path for the cert-manager/external providers.

# --- Lease -------------------------------------------------------------------
lease_ttl: "2m"   # TTL of a client's engine lease; renew before this expires.

# --- Pipeline disconnect detection -------------------------------------------
# Detects when the owning client's L4 data-plane tunnel closes and transitions
# the associated trace_meta to "failed" (idempotent, replicated). A background
# staleness sweeper recovers traces orphaned by a supervisor restart/crash.
# See ADR-019.
pipeline:
  disconnect_grace: "0s"        # grace period before a closed tunnel fails the trace.
                                # 0s = fail immediately on tunnel close (default). >0s =
                                # wait this long, allowing a same-trace reconnect to cancel.
  stale_sweep:                  # supervisor-restart / crash recovery sweeper.
    enabled: true               # master switch; enabled by default.
    schedule: "1m"              # how often the sweeper scans for stale running traces.
    stale_after: "5m"           # mark running traces with no active lease (InFlight == 0)
                                # failed once their sort key is older than this.
  metrics:                      # trace-scoped engine resource metrics (pipeline view card).
    enabled: true               # serve GET /api/v1/traces/:id/metrics (cAdvisor container_* series).
    step: "15s"                 # query_range resolution; must be > 0 when enabled.

# --- Allowed Dagger engine versions ------------------------------------------
version:
  floor: "v0.19.0"                          # minimum engine version admitted.
  allowlist: ["0.19", "0.20", "0.21"]       # major.minor prefixes admitted (empty = admit all >= floor).

# --- CI integration feature flags -------------------------------------------
# These toggle optional niceties; safe to leave at defaults.
ci:
  github:
    job_summary: true      # post a $GITHUB_STEP_SUMMARY with the trace link.
    check_runs: true      # create Check Runs annotated with cache stats.
  jenkins:
    dynamic_stages: true          # split Dagger steps into nested Jenkins stages (Blue Ocean).
    steps_poll_interval: "2s"     # how often the CI wrapper polls the supervisor for new steps/logs.
    steps_max_depth: 8            # maximum nested step depth surfaced (0 = unlimited).
  drone:
    config_extension: true # enable the .drone.yml config extension.

# --- On-the-fly Dagger CLI provisioning ------------------------------------
cli:
  enabled: true                       # serve verified Dagger CLI tarballs + latest-version resolution.
  cache_repo: "dagger-kubernetes/cli-cache"  # legacy repo name retained for config compatibility; the S3 cache ignores it.
  release_list_ttl: "1h"              # how long to cache the upstream release list in memory.
  download_timeout: "5m"              # outbound fetch timeout for the tarball/checksums.
  # S3 backend: tarballs are stored at
  # s3://<bucket>/<s3_prefix>/<version>/<os>/<arch>/<filename>. The rest of
  # the S3 client (endpoint, region, SSL, credentials) is configured once via
  # cache.s3.*.
  s3_bucket: ""                       # CLI-cache bucket; empty = cache.s3.bucket.
  s3_prefix: "cli-cache"              # S3 key prefix for CLI tarballs.
  upstream:
    releases_url: "https://api.github.com/repos/dagger/dagger/releases"   # release discovery (mirror-able).
    download_base: "https://github.com/dagger/dagger/releases/download"   # tarball + checksums.txt base (mirror-able).
    github_token: ""                  # optional; set via DAGGER_KUBERNETES_CLI_UPSTREAM_GITHUB_TOKEN (raises rate limit).
  ci_wrapper_path: "/usr/local/bin/dagger-kubernetes-ci"  # path to the pre-built CI wrapper binary served at /api/v1/cli/ci-wrapper/latest.

# --- Project → group attribution ---------------------------------------------
# Config-driven mapping of a project name (CI repo slug, e.g.
# "github.com/acme/api") to a supervisor group name, applied at OTLP ingest.
# This is the declarative counterpart to a group's per-group
# auto_assign_pattern (set via the admin API/UI). Precedence, highest first:
#   1. explicit project assignment (project.group_id already set) — never touched;
#   2. attribution.project_mappings — when a rule matches it is authoritative:
#      if its target group is missing the project is skipped (no fallthrough);
#   3. per-group auto_assign_pattern — runs only when no config rule matches.
# Rules are ordered and first-match-wins. Patterns are Go regexps matched
# against the project name, case-sensitive ((?i) opts in); always anchor
# (^...$) or a pattern also matches longer names. The target group is a literal
# name (no capture substitution) and must already exist — missing targets are
# skipped with a WARN, never auto-created. An empty list (the default) disables
# the feature and leaves auto_assign_pattern behavior unchanged.
attribution:
  project_mappings: []               # ordered list of {pattern, group}; empty = disabled.
    # - pattern: '^github\.com/acme/.*'   # Go regexp vs project name (case-sensitive; (?i) opt-in).
    #   group: 'acme'                      # literal target supervisor group name (must exist).

# --- Logging -----------------------------------------------------------------
log_level: "info"    # debug | info | warn | error
log_format: "json"   # json | text — the supervisor's own log format.

# --- Outgoing OTLP -----------------------------------------------------------
otel:
  otlp_endpoint: ""  # if set, the Supervisor exports its own OTLP here; empty disables.
  # OTLP ingest request-body cap in bytes (0 = supervisor default 64 MiB). This
  # is separate from the 4 MiB control-API cap: OTLP log/trace batches are
  # legitimately large. Keep the ingress `proxy-body-size` annotation and the
  # collector's `max_request_body_size` at least this large.
  ingest_max_body_size: 67108864  # 64 MiB.
